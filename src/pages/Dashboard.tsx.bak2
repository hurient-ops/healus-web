          </Link>
          
          <nav className="hidden md:flex items-center gap-8 font-normal text-gray-600">
            <Link to="/diabetes" className="hover:text-[#17409c] transition-colors">?πÎá®Î≥ëÏùò ?¥Ìï¥</Link>
            <Link to="/diet" className="hover:text-[#1cb085] transition-colors">?ùÎã® Í¥ÄÎ¶?/Link>
            <Link to="/pump-guide" className="hover:text-orange-600 transition-colors">?åÌîÑ Í∞Ä?¥Îìú</Link>
            <Link to="/complications" className="hover:text-red-600 transition-colors">?©Î≥ëÏ¶??àÎ∞©</Link>
          </nav>
          
          <div className="w-16"></div>
        </div>
      </header>

      <main id="dashboard-content" className="max-w-7xl mx-auto px-6 py-10 relative z-10 bg-gray-50">
        <div className="mb-10 flex justify-between items-end">
