            >
              <Plus className="w-5 h-5"/>
              ?òÎèô Í∏∞Î°ù
            </button>
          </div>
        </div>

        {/* 1. TOP ROW: 5 Gauge Charts */}
        <div className="grid grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
          <KPIDonut value={targetBgPercent} maxValue={100} label="Î™©Ìëú ?àÎãπ ?¨ÏÑ±Î•? unit="%" color={PRIMARY_COLOR} />
          <KPIDonut value={avgBg} maxValue={300} label="?âÍ∑† ?àÎãπ" unit="mg/dL" color={SECONDARY_COLOR} />
          <KPIDonut value={avgBasal} maxValue={30} label="Í∏àÏùº Í∏∞Ï¥à Ï£ºÏûÖ" unit="U" color={ACCENT_COLOR} />
          <KPIDonut value={avgBolus} maxValue={50} label="Í∏àÏùº ?ùÏÇ¨ Ï£ºÏûÖ" unit="U" color="#f59e0b" />
          <KPIDonut value={avgAppend} maxValue={20} label="Í∏àÏùº Ï∂îÍ? Ï£ºÏûÖ" unit="U" color="#8b5cf6" />
        </div>

        {/* 2. MIDDLE ROW: Summary Table (Left) & Trend Line Chart (Right) */}
        <div className="grid lg:grid-cols-12 gap-8 mb-8">
          {/* Summary Column */}
          <div className="lg:col-span-4 flex flex-col gap-6">
