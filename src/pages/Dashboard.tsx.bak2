          <p className="text-sm text-gray-600 flex justify-between gap-4"><span>?ùÏÇ¨Ï£ºÏûÖ:</span> <span className="font-bold text-[#1cb085]">{log.bolus.toFixed(1)} U</span></p>
          <p className="text-sm text-gray-600 flex justify-between gap-4"><span>Í∏∞Ï¥àÏ£ºÏûÖ:</span> <span className="font-bold text-[#4a90e2]">{log.basal.toFixed(1)} U</span></p>
          <p className="text-sm text-gray-600 flex justify-between gap-4"><span>Ï∂îÍ?Ï£ºÏûÖ:</span> <span className="font-bold text-[#8b5cf6]">{log.append.toFixed(1)} U</span></p>
