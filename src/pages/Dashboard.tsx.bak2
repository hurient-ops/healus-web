          </div>
        </div>
        <h4 className="text-sm font-bold text-gray-700 mt-2 z-10">{label}</h4>
      </div>
    );
  };

  // Custom Tooltip for Trend Chart
  const CustomTooltip = ({ active, payload, label }: any) => {
